<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ pages[active].title | safe }}</title>
<meta name="description" content="{{ pages[active].description | safe }}">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230f2342'/%3E%3Cg stroke-linecap='round' fill='none' stroke-width='7'%3E%3Cpath d='M50 58 V34' stroke='%23f2b01e'/%3E%3Cpath d='M66 60 L82 44' stroke='%23d8752a'/%3E%3Cpath d='M34 60 L18 44' stroke='%234faedb'/%3E%3C/g%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/styles.css">
<link rel="canonical" href="{{ site.url }}/{{ canonical }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Zuwa Investments Limited">
<meta property="og:title" content="{{ pages[active].title | safe }}">
<meta property="og:description" content="{{ pages[active].description | safe }}">
<meta property="og:url" content="{{ site.url }}/{{ canonical }}">
<meta property="og:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pages[active].title | safe }}">
<meta name="twitter:description" content="{{ pages[active].description | safe }}">
<meta name="twitter:image" content="{{ site.url }}/assets/img/og-cover.jpg">
<meta name="theme-color" content="#0f2342">
</head>
<body>
<header class="nav" id="nav">
  <div class="wrap">
    <a class="nav-logo" href="index.html" aria-label="Zuwa Investments Limited"><img src="assets/img/logo-white.png" alt="Zuwa Investments Limited"></a>
    <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
    <ul class="nav-links" id="navlinks">
      <li><a href="index.html"{% if active == "index" %} class="active"{% endif %}>Home</a></li>
      <li class="has-drop{% if dropactive == "offers" %} dactive{% endif %}"><span class="drop-toggle">Offers <i>&#9662;</i></span>
        <div class="drop">
          <a href="build-to-keys.html"{% if active == "build-to-keys" %} class="active"{% endif %}>Build-to-Keys</a>
          <a href="contractor-cleaning.html"{% if active == "contractor-cleaning" %} class="active"{% endif %}>Contractor cleaning</a>
          <a href="care-plan.html"{% if active == "care-plan" %} class="active"{% endif %}>Care Plan</a>
        </div></li>
      <li class="has-drop{% if dropactive == "services" %} dactive{% endif %}"><span class="drop-toggle">Services <i>&#9662;</i></span>
        <div class="drop">
          <a href="construction.html"{% if active == "construction" %} class="active"{% endif %}>Construction</a>
          <a href="cleaning.html"{% if active == "cleaning" %} class="active"{% endif %}>Cleaning</a>
          <a href="supply.html"{% if active == "supply" %} class="active"{% endif %}>Supply</a>
        </div></li>
      <li><a href="projects.html"{% if active == "projects" %} class="active"{% endif %}>Projects</a></li>
      <li><a href="about.html"{% if active == "about" %} class="active"{% endif %}>About</a></li>
      <li><a href="careers.html"{% if active == "careers" %} class="active"{% endif %}>Careers</a></li>
      <li><a href="contact.html"{% if active == "contact" %} class="active"{% endif %}>Contact</a></li>
      <li class="nav-cta"><a class="btn btn-primary" href="book.html">Book a service <span class="arw">&rarr;</span></a></li>
    </ul>
  </div>
</header>
{{ content | safe }}
<footer class="footer">
  <div class="wrap">
    <div class="fgrid">
      <div>
        <img class="flogo" src="assets/img/logo-white.png" alt="Zuwa Investments Limited">
        <p class="fabout">{{ company.about_blurb }}</p>
      </div>
      <div>
        <h4>Offers</h4>
        <ul>
          <li><a href="build-to-keys.html">Build-to-Keys</a></li>
          <li><a href="contractor-cleaning.html">Contractor cleaning</a></li>
          <li><a href="care-plan.html">Care Plan</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="construction.html">Construction</a></li>
          <li><a href="cleaning.html">Cleaning</a></li>
          <li><a href="supply.html">Supply</a></li>
          <li><a href="projects.html">Projects</a></li>
          <li><a href="about.html">About</a></li>
          <li><a href="careers.html">Careers</a></li>
          <li><a href="contact.html">Contact</a></li>
        </ul>
      </div>
      <div class="fcontact">
        <h4>Get in touch</h4>
        <div><span class="k">Call / WhatsApp</span><a href="tel:{{ company.phone_link }}">{{ company.phone_display }}</a></div>
        <div><span class="k">Email</span><a href="mailto:{{ company.email }}">{{ company.email }}</a></div>
        <div><span class="k">Office</span>{{ company.address_line1 }}<br>{{ company.address_line2 }}</div>
        <div><span class="k">Hours</span>{{ company.hours_weekday }}<br>{{ company.hours_saturday }}</div>
      </div>
    </div>
    <div class="fbar">
      <span>&copy; <span data-year>2026</span> {{ company.name }}. All rights reserved.</span>
      <span class="slogan">{{ company.tagline }}</span>
    </div>
  </div>
</footer>
<button class="totop" aria-label="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19V5M6 11l6-6 6 6"/></svg></button>
<script src="assets/js/site.js"></script>
</body>
</html>